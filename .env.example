# 真实配置写在 .env.local(已被 git 忽略),本文件只是模板,不要放真实 Key
OPENAI_API_KEY=
# 默认 gpt-image-1;如使用其他模型在此覆盖
OPENAI_IMAGE_MODEL=gpt-image-1
# PDF 卖点提取用的文本模型,默认 gpt-4o-mini
OPENAI_TEXT_MODEL=
# Icon Design VI 图片解析用的视觉模型,默认继承 OPENAI_TEXT_MODEL 或 gpt-4o-mini
OPENAI_VISION_MODEL=
# 可选:API 中转地址(以 /v1 结尾),默认 https://api.openai.com/v1
OPENAI_BASE_URL=
# 可选:本地代理(如 http://127.0.0.1:10808)
OPENAI_PROXY_URL=

# 火山方舟：Seedream 图片与即梦 Seedance 视频共用此 Key
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 可选：方舟专用 HTTP/HTTPS 代理
ARK_PROXY_URL=
DOUBAO_IMAGE_MODEL=doubao-seedream-5-0-lite-260128
# 可选：优先使用账号已创建的视频推理接入点（推荐，格式 ep-...）
DOUBAO_VIDEO_ENDPOINT_ID=
DOUBAO_VIDEO_MODEL=doubao-seedance-2-0-fast-260128
# 首选模型无权限时依次尝试，逗号分隔；留空则默认尝试 Seedance 1.0 Pro
DOUBAO_VIDEO_FALLBACK_MODELS=doubao-seedance-1-0-pro-250528
# Seedance 图生视频默认使用 first_frame；仅支持参考图模式的模型改为 reference_image
DOUBAO_VIDEO_IMAGE_ROLE=first_frame

# ===== Multi-user platform（必填项见注释） =====
# 必填：PostgreSQL 连接串
DATABASE_URL=postgresql://midea:midea@127.0.0.1:5433/midea_ai_studio?schema=public
# 必填：会话签名密钥，至少 32 字符。生成：openssl rand -base64 32
AUTH_SECRET=replace-with-at-least-32-random-characters
# 可选：加密 /admin/ai 中保存的供应商密钥（未设置时回退 AUTH_SECRET）
AI_CONFIG_SECRET=

# 可选：每用户每月 AI 预算默认值（估算单位）。未设置 = 不限制；用户可单独覆盖（0 = 不限制）
# DEFAULT_MONTHLY_BUDGET_UNITS=500

# 可选：Redis（多副本共享限流；未设置时使用进程内限流）
# REDIS_URL=redis://127.0.0.1:6379

# 可观测性：Prometheus 抓取令牌（>=16 字符）。不设置时 /api/metrics 仅管理员会话可访问。
# METRICS_TOKEN=
# 告警阈值：排队任务数、24 小时失败率（0-1）
# ALERT_QUEUE_DEPTH=100
# ALERT_FAILURE_RATE=0.2
# 可选：Slack 兼容告警 Webhook（Worker 每分钟巡检，去重 + 恢复通知）
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxx
# ALERT_COOLDOWN_MS=900000
AUTH_TRUST_HOST=true

# 任务队列
JOB_CONCURRENCY=3
MAX_USER_ACTIVE_JOBS=2
JOB_LOCK_MS=900000
JOB_POLL_INTERVAL_MS=1500
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_MS=5000
JOB_RETRY_MAX_MS=300000
WORKER_HEARTBEAT_MS=10000
WORKER_HEARTBEAT_STALE_MS=60000
# /api/ready 是否要求 worker 心跳（容器编排建议 true；仅启动 web 调试时 false）
READY_REQUIRE_WORKER=false

# 上传与存储
STORAGE_ROOT=public
MAX_UPLOAD_BYTES=31457280
MAX_FILES_PER_REQUEST=10
USER_STORAGE_QUOTA_BYTES=2147483648
CLEANUP_RETENTION_DAYS=30

# 认证
BCRYPT_COST=12
AUTH_SESSION_MAX_AGE_S=604800
AUTH_SESSION_UPDATE_AGE_S=86400
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000

# API 限流（单实例内存实现；多副本部署需替换为 Redis）
RATE_LIMIT_LIMIT=30
RATE_LIMIT_WINDOW_MS=60000

# 种子账号（仅开发环境允许默认密码；生产必须显式提供强密码）
SEED_ADMIN_EMAIL=demo@midea.local
SEED_ADMIN_PASSWORD=demo1234
